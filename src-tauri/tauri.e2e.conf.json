{
  "identifier": "app.sageroom.desktop.e2e",
  "productName": "Sageroom 测试",
  "app": {
    "security": {
      "capabilities": ["main", { "identifier": "desktop-test-zoom", "windows": ["main"], "local": true, "permissions": ["core:webview:allow-set-webview-zoom"] }]
    },
    "windows": [
      {
        "label": "main",
        "title": "Sageroom 测试",
        "width": 1100,
        "height": 780,
        "minWidth": 860,
        "minHeight": 620,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "center": true
      }
    ]
  }
}
